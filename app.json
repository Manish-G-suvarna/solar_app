{
  "expo": {
    "name": "SolarFlow - Smart Solar Monitoring",
    "slug": "solarflow-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F4F7F5",
    "primaryColor": "#0E5C41",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.solarflow.app"
    },
    "android": {
      "package": "com.solarflow.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow SolarFlow to access your location to fetch real-time weather and temperature for your solar system."
        }
      ],
      "expo-font",
      "expo-status-bar"
    ]
  }
}
